# Copy to `.env` in the repo root (gitignored) to override defaults for Docker Compose and local tooling.
#
# Local Vite + `npm run server`: keep production values in `.env` if you deploy from this file,
# but do not set NODE_ENV=production here unless the API should reject localhost CORS. Prefer
# `npm run dev` (forces NODE_ENV=development) or copy `.env.local.example` → `.env.local`.

# --- docker-compose.prod.yml (single VPS: Caddy + API + MySQL)
# Same MYSQL_* and API variables as below. MySQL is not published to the host; Caddy exposes HTTPS.
#
# Production required (server exits on startup if missing when NODE_ENV=production):
#   NODE_ENV=production
#   ALLOWED_ORIGINS=https://your-domain.example
#   TRUST_PROXY=1
#   JWT_ACCESS_SECRET=<long random>
#   JWT_REFRESH_SECRET=<long random>
#   DB_USER, DB_PASSWORD, DB_NAME
# Vite client (see also `.env.development` for local dev defaults)
# Production / Docker SPA build (same-origin nginx → API):
# VITE_GRAPHQL_URL=/graphql
# Local `npm run client` uses Vite: by default the client calls same-origin `/graphql`, which Vite proxies
# to http://localhost:4000 (see client/vite.config.ts). Override only if you need a direct URL:
# VITE_GRAPHQL_URL=http://localhost:4000/graphql

# --- Docker Compose (mysql service) — required by docker-compose.yml
# MYSQL_ROOT_PASSWORD=root_password
# MYSQL_DATABASE=budget_app
# MYSQL_USER=budget_user
# MYSQL_PASSWORD=budget_password

# --- API server
# PORT=4000
# Trust X-Forwarded-* when behind a reverse proxy
# TRUST_PROXY=1

# Max JSON body size for Express (e.g. 512kb, 1mb)
# JSON_BODY_LIMIT=512kb

# GraphQL recursive selection depth/complexity guard (Apollo maxRecursiveSelections)
# GRAPHQL_MAX_RECURSIVE_SELECTIONS=100

# GraphQL rate limits (15-minute window)
# GRAPHQL_RATE_LIMIT_AUTH=100
# GRAPHQL_RATE_LIMIT_SESSION=60
# GRAPHQL_RATE_LIMIT_GENERAL=800

# CORS: comma-separated browser origins (defaults to local Vite/SPA ports if unset)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional httpOnly cookie names
# AUTH_ACCESS_COOKIE_NAME=budgetshare_access
# AUTH_REFRESH_COOKIE_NAME=budgetshare_refresh
# Non-secret client hint so ME is skipped when logged out (set by server on login)
# AUTH_SESSION_HINT_COOKIE_NAME=budgetshare_session

# Audit log retention on startup (days; default 90; set 0 to disable purge)
# AUDIT_LOG_RETENTION_DAYS=90

# Database (API process; match Docker MYSQL_* if using compose defaults)
# `npm run server` loads this file automatically. When DB_* are unset, the API uses MYSQL_*.
# If login fails with ER_ACCESS_DENIED, your MySQL volume may predate .env — set DB_PASSWORD to
# the password MySQL was created with, or recreate the docker volume.
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=budget_user
# DB_PASSWORD=budget_password
# DB_NAME=budget_app

# JWT — required when NODE_ENV is not development
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800

# --- Outbound email (household invitations for members without accounts)
# If SMTP_* is incomplete, invitations are still stored in DB but no email is sent (see server logs: invitation_email_skipped).
# APP_PUBLIC_URL=https://your-app.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="BudgetShare <noreply@example.com>"
# SMTP_RETRY_MAX_ATTEMPTS=3
# SMTP_RETRY_BASE_DELAY_MS=300

# --- Vite client (build-time)
# Vite loads `.env*` from `client/` (where vite.config.ts lives). Example file: `client/.env.local`
# VITE_GRAPHQL_URL=http://localhost:4000/graphql
