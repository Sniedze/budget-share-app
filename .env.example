# Copy to `.env` in the repo root (gitignored) to override defaults for Docker Compose and local tooling.

# --- docker-compose.prod.yml (single VPS: nginx + API + MySQL)
# Same MYSQL_* and API variables as below. MySQL is not published to the host; only port 80 is exposed on `web`.
# Set ALLOWED_ORIGINS to your public site origin (for example https://budget.example.com).
# Optional build-time override for the SPA (default is same-origin `/graphql`):
# VITE_GRAPHQL_URL=/graphql

# --- Docker Compose (mysql service) — required by docker-compose.yml
# MYSQL_ROOT_PASSWORD=root_password
# MYSQL_DATABASE=budget_app
# MYSQL_USER=budget_user
# MYSQL_PASSWORD=budget_password

# --- API server
# PORT=4000
# Trust X-Forwarded-* when behind a reverse proxy
# TRUST_PROXY=1

# Max JSON body size for Express (e.g. 512kb, 1mb)
# JSON_BODY_LIMIT=512kb

# GraphQL recursive selection depth/complexity guard (Apollo maxRecursiveSelections)
# GRAPHQL_MAX_RECURSIVE_SELECTIONS=30

# GraphQL per-IP rate limits (15-minute window)
# GRAPHQL_RATE_LIMIT_AUTH=100
# GRAPHQL_RATE_LIMIT_GENERAL=800

# CORS: comma-separated browser origins (defaults to local Vite/SPA ports if unset)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional httpOnly cookie names
# AUTH_ACCESS_COOKIE_NAME=budgetshare_access
# AUTH_REFRESH_COOKIE_NAME=budgetshare_refresh

# Database (API process; match Docker MYSQL_* if using compose defaults)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=budget_user
# DB_PASSWORD=budget_password
# DB_NAME=budget_app

# JWT — required when NODE_ENV is not development
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800

# --- Outbound email (household invitations for members without accounts)
# If SMTP_* is incomplete, invitations are still stored in DB but no email is sent (see server logs: invitation_email_skipped).
# APP_PUBLIC_URL=https://your-app.example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=0
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="BudgetShare <noreply@example.com>"
# SMTP_RETRY_MAX_ATTEMPTS=3
# SMTP_RETRY_BASE_DELAY_MS=300

# --- Vite client (build-time)
# Vite loads `.env*` from `client/` (where vite.config.ts lives). Example file: `client/.env.local`
# VITE_GRAPHQL_URL=http://localhost:4000/graphql
