# Copy to `.env` in the repo root (gitignored) to override defaults for Docker Compose and local tooling.

# --- Docker Compose (mysql service) — optional overrides; compose uses the values after :- if unset
# MYSQL_ROOT_PASSWORD=root_password
# MYSQL_DATABASE=budget_app
# MYSQL_USER=budget_user
# MYSQL_PASSWORD=budget_password

# --- API server
# PORT=4000
# Trust X-Forwarded-* when behind a reverse proxy
# TRUST_PROXY=1

# CORS: comma-separated browser origins (defaults to local Vite/SPA ports if unset)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (API process; match Docker MYSQL_* if using compose defaults)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=budget_user
# DB_PASSWORD=budget_password
# DB_NAME=budget_app

# JWT — required when NODE_ENV is not development
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_TTL_SECONDS=900
# JWT_REFRESH_TTL_SECONDS=604800

# --- Vite client (build-time)
# Vite loads `.env*` from `client/` (where vite.config.ts lives). Example file: `client/.env.local`
# VITE_GRAPHQL_URL=http://localhost:4000/graphql
