# Copy to `.env` in the repo root (gitignored) for local overrides.

# --- Docker Compose (mysql)
# MYSQL_ROOT_PASSWORD=root_password
# MYSQL_DATABASE=budget_app
# MYSQL_USER=budget_user
# MYSQL_PASSWORD=budget_password

# --- API server
# PORT=4000
# TRUST_PROXY=1

# CORS (comma-separated origins; defaults to local dev if unset)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional httpOnly cookie names
# AUTH_ACCESS_COOKIE_NAME=budgetshare_access
# AUTH_REFRESH_COOKIE_NAME=budgetshare_refresh

# Database
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=budget_user
# DB_PASSWORD=budget_password
# DB_NAME=budget_app

# JWT (required when NODE_ENV=production)
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

# --- Vite (`client/.env.local`)
# VITE_GRAPHQL_URL=http://localhost:4000/graphql
