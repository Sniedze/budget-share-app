# syntax=docker/dockerfile:1
# Build the SPA bundle, then ship it inside a Caddy image that handles HTTPS automatically.
FROM node:20-bookworm-slim AS client-builder
WORKDIR /app
COPY client/package.json client/package-lock.json ./client/
COPY server/src/graphql/schema.graphql ./server/src/graphql/schema.graphql
WORKDIR /app/client
RUN npm ci
COPY client/ ./
ARG VITE_GRAPHQL_URL=/graphql
ENV VITE_GRAPHQL_URL=${VITE_GRAPHQL_URL}
RUN npm run build

FROM caddy:2.8-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=client-builder /app/client/dist /srv
