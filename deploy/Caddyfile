soperfect.dk, www.soperfect.dk {
    encode gzip zstd

    # Backend GraphQL API and health check
    handle /graphql* {
        reverse_proxy api:4000
    }

    handle /health {
        reverse_proxy api:4000
    }

    # SPA fallback: serve index.html for any unknown route so React Router works
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
